# ==============================================================================
# Public Data Gateway — Optional Environment Configuration (.env.example)
# Copy to .env locally if needed. NEVER commit real secrets or tokens.
# ==============================================================================

# Storage & Medallion Lakehouse Root (defaults to <repo>/data)
PDG_DATA_DIR=
PDG_DUCKDB_MEMORY_LIMIT=4GB
PDG_HTTP_USER_AGENT=PublicDataGateway/0.1.0 (+https://github.com/jhsfhtls/public-data-gateway)
PDG_CACHE_DEFAULT_TTL_SECONDS=86400

# Legacy compatibility aliases (optional)
BDG_DATA_DIR=
BDG_HTTP_USER_AGENT=

# Optional Government API Keys (only required for authenticated connectors)
CGU_API_TOKEN=
DATAJUD_PUBLIC_API_KEY=

# Optional Google BigQuery Federation (Base dos Dados)
GCP_BILLING_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
BDG_BQ_MAX_BYTES_BILLED=1073741824
