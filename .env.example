# ==============================================================================
# Brazil Data Gateway — Optional Environment Configuration (.env.example)
# Copy to .env locally if needed. NEVER commit real secrets or tokens.
# ==============================================================================

# Storage & Medallion Lakehouse Root (defaults to <repo>/data)
BDG_DATA_DIR=
BDG_DUCKDB_MEMORY_LIMIT=4GB
BDG_HTTP_USER_AGENT=BrazilDataGateway/0.1.0 (+https://github.com/jhsfhtls/brazil-data-gateway; CORE-Ecosystem)
BDG_CACHE_DEFAULT_TTL_SECONDS=86400

# Optional Government API Keys (only required for authenticated connectors)
CGU_API_TOKEN=
DATAJUD_PUBLIC_API_KEY=

# Optional Google BigQuery Federation (POP_T_176 — Base dos Dados)
GCP_BILLING_PROJECT_ID=project-f9519bed-593f-435f-b78
GOOGLE_APPLICATION_CREDENTIALS=
BDG_BQ_MAX_BYTES_BILLED=1073741824
