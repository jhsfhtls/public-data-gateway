# ==============================================================================
# Public Data Gateway — Optional Environment Configuration (.env.example)
# Copy to .env locally if needed. NEVER commit real secrets or tokens.
# ==============================================================================

# Storage & Medallion Lakehouse Root (defaults to <repo>/data)
PDG_DATA_DIR=
PDG_DUCKDB_MEMORY_LIMIT=4GB
PDG_HTTP_USER_AGENT=PublicDataGateway/0.1.0 (+https://github.com/jhsfhtls/public-data-gateway)
PDG_CACHE_DEFAULT_TTL_SECONDS=86400

# Legacy compatibility aliases (optional)
BDG_DATA_DIR=
BDG_HTTP_USER_AGENT=

# Optional Government API Keys (only required for authenticated connectors)
CGU_API_TOKEN=
DATAJUD_PUBLIC_API_KEY=

# Optional Google BigQuery Federation (Cloud Public Datasets & FinOps Guard)
GCP_BILLING_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
BDG_BQ_MAX_BYTES_BILLED=1073741824
BDG_BQ_DATASET=public_data_gateway

# Optional Cloud Lakehouse Mirror (Phase 11 Open Core: local | s3 | r2)
BDG_MIRROR_PROVIDER=local
BDG_MIRROR_BUCKET=
BDG_MIRROR_PREFIX=public-data-gateway
BDG_MIRROR_ENDPOINT_URL=
BDG_MIRROR_REGION=auto
BDG_MIRROR_ACCESS_KEY_ID=
BDG_MIRROR_SECRET_ACCESS_KEY=
BDG_MIRROR_LOCAL_DIR=

# Optional Serverless Public Data Warehouse (duckdb | motherduck | bigquery)
BDG_WAREHOUSE_PROVIDER=duckdb
BDG_MOTHERDUCK_TOKEN=
BDG_MOTHERDUCK_DATABASE=public_data_gateway
